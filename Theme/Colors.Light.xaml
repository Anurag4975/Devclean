<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================== -->
    <!-- LIGHT THEME — semantic color tokens       -->
    <!-- Every brush a control template references -->
    <!-- lives here so ApplyTheme() can swap the   -->
    <!-- whole dictionary in one shot.             -->
    <!-- ======================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#F8F9FA" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A5C66" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A6A9B2" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Structure -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E5EA" />

    <!-- Accent -->
    <SolidColorBrush x:Key="BlueBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="GreenBrush" Color="#107C10" />
    <SolidColorBrush x:Key="GoldBrush" Color="#8A6D3B" />
    <SolidColorBrush x:Key="RedBrush" Color="#D13438" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#FF8C00" />

    <!-- Safety -->
    <SolidColorBrush x:Key="SafeBrush" Color="#107C10" />
    <SolidColorBrush x:Key="ReviewBrush" Color="#8A6D3B" />
    <SolidColorBrush x:Key="CautionBrush" Color="#FF8C00" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D13438" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#106EBE" />
    <SolidColorBrush x:Key="SuccessButtonBrush" Color="#107C10" />
    <SolidColorBrush x:Key="SuccessButtonHoverBrush" Color="#0E6E0E" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#D13438" />
    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#B92B2E" />
    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="NeutralButtonHoverBrush" Color="#E4E7EC" />

    <!-- Soft accent surfaces (pills, callouts) -->
    <SolidColorBrush x:Key="AccentColorLight" Color="#FDEAEA" />
    <SolidColorBrush x:Key="TabActiveBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="InfoPillBackgroundBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="InfoPillForegroundBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="WarningPillBackgroundBrush" Color="#F8F4E9" />
    <SolidColorBrush x:Key="WarningPillForegroundBrush" Color="#8A6D3B" />
    <SolidColorBrush x:Key="SuccessPillBackgroundBrush" Color="#E8F8E8" />
    <SolidColorBrush x:Key="SuccessPillForegroundBrush" Color="#107C10" />
    <SolidColorBrush x:Key="AccentSoftBackgroundBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="AccentSoftForegroundBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#FEDCDC" />
    <SolidColorBrush x:Key="DonateBackgroundBrush" Color="#FFF4E5" />
    <SolidColorBrush x:Key="DonateForegroundBrush" Color="#B36B00" />

    <!-- Inputs (TextBox / PasswordBox / ComboBox) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#1A1A1F" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D0D3D9" />
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="InputBorderFocusBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#8A8D96" />

    <!-- Interactive control chrome (ComboBox popup, ListView rows, CheckBox, ScrollBar) -->
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F4FC" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E1E9F7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#8A8D96" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C7CAD1" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A6A9B2" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#D0D3D9" />

    <!-- Layout/Misc -->
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.08" BlurRadius="10" ShadowDepth="2" Direction="270" />

</ResourceDictionary>
