<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================== -->
    <!-- DARK THEME — same keys as Colors.Light,   -->
    <!-- so every control template and style keeps -->
    <!-- working unchanged when this is swapped in.-->
    <!-- ======================================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="CardAltBrush" Color="#3A3A3C" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAB2" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Structure -->
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="DividerBrush" Color="#48484A" />

    <!-- Accent -->
    <SolidColorBrush x:Key="BlueBrush" Color="#4CA3E8" />
    <SolidColorBrush x:Key="GreenBrush" Color="#5FC65F" />
    <SolidColorBrush x:Key="GoldBrush" Color="#D8B675" />
    <SolidColorBrush x:Key="RedBrush" Color="#FF6B6E" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#FFA94D" />

    <!-- Safety -->
    <SolidColorBrush x:Key="SafeBrush" Color="#5FC65F" />
    <SolidColorBrush x:Key="ReviewBrush" Color="#D8B675" />
    <SolidColorBrush x:Key="CautionBrush" Color="#FFA94D" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6E" />

    <!-- Buttons -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#0E88E8" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#2C9CF0" />
    <SolidColorBrush x:Key="SuccessButtonBrush" Color="#1F9D1F" />
    <SolidColorBrush x:Key="SuccessButtonHoverBrush" Color="#2CB32C" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#E04448" />
    <SolidColorBrush x:Key="DangerButtonHoverBrush" Color="#F0585C" />
    <SolidColorBrush x:Key="NeutralButtonBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="NeutralButtonHoverBrush" Color="#48484A" />

    <!-- Soft accent surfaces (pills, callouts) -->
    <SolidColorBrush x:Key="AccentColorLight" Color="#3A2426" />
    <SolidColorBrush x:Key="TabActiveBrush" Color="#143C64" />
    <SolidColorBrush x:Key="InfoPillBackgroundBrush" Color="#143C64" />
    <SolidColorBrush x:Key="InfoPillForegroundBrush" Color="#6CB6F5" />
    <SolidColorBrush x:Key="WarningPillBackgroundBrush" Color="#3D3520" />
    <SolidColorBrush x:Key="WarningPillForegroundBrush" Color="#E3C888" />
    <SolidColorBrush x:Key="SuccessPillBackgroundBrush" Color="#1F3620" />
    <SolidColorBrush x:Key="SuccessPillForegroundBrush" Color="#7BD37B" />
    <SolidColorBrush x:Key="AccentSoftBackgroundBrush" Color="#143C64" />
    <SolidColorBrush x:Key="AccentSoftForegroundBrush" Color="#6CB6F5" />
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#5C3436" />
    <SolidColorBrush x:Key="DonateBackgroundBrush" Color="#3D3018" />
    <SolidColorBrush x:Key="DonateForegroundBrush" Color="#E3A85C" />

    <!-- Inputs (TextBox / PasswordBox / ComboBox) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2C2C2E" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#F0F0F2" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#48484A" />
    <SolidColorBrush x:Key="InputBorderHoverBrush" Color="#4CA3E8" />
    <SolidColorBrush x:Key="InputBorderFocusBrush" Color="#4CA3E8" />
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#8E8E93" />

    <!-- Interactive control chrome (ComboBox popup, ListView rows, CheckBox, ScrollBar) -->
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3C" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#48484A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#143C64" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#4CA3E8" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="CheckMarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#5A5A5D" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#7A7A7D" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#48484A" />

    <!-- Layout/Misc -->
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" Opacity="0.35" BlurRadius="12" ShadowDepth="2" Direction="270" />

</ResourceDictionary>
