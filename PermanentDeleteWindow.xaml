<Window x:Class="DevClean.PermanentDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Permanent Deletion"
        Width="900"
        Height="700"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Icon="pack://siteoforigin:,,,/Assets/AppIcon.ico"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{DynamicResource AccentColorLight}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="0,0,0,0"
                CornerRadius="{StaticResource CardRadius}"
                Padding="18,14"
                Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource DangerBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Permanent Deletion" Style="{StaticResource TitleText}" FontSize="22"/>
                </StackPanel>
                <TextBlock x:Name="WarningText"
                           Text="This action cannot be undone."
                           Foreground="{DynamicResource DangerBrush}"
                           FontWeight="SemiBold"
                           FontSize="13.5"
                           Margin="30,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- SUMMARY -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCardBorder}" Margin="0,0,8,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Files" Style="{StaticResource StatLabelText}"/>
                    <TextBlock x:Name="FileCountText" Text="0" Style="{StaticResource StatValueText}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatCardBorder}" Margin="8,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Total size" Style="{StaticResource StatLabelText}"/>
                    <TextBlock x:Name="TotalSizeText" Text="0 B" Style="{StaticResource StatValueText}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCardBorder}" Margin="8,0,0,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource StatLabelText}"/>
                    <TextBlock x:Name="SafetySummaryText"
                               Text="Safe: 0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILE LIST -->
        <Border Grid.Row="2" Style="{StaticResource ListContainerBorder}" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,8,10,10">
                    <TextBlock Text="Selected files" Style="{StaticResource SectionHeaderText}"/>
                    <TextBlock x:Name="ListCountText"
                               HorizontalAlignment="Right"
                               Style="{StaticResource SecondaryText}"/>
                </Grid>

                <ListView x:Name="FileList" Grid.Row="1">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File" Width="210" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeDisplay}"/>
                            <GridViewColumn Header="Category" Width="130" DisplayMemberBinding="{Binding Category}"/>
                            <GridViewColumn Header="Safety" Width="100" DisplayMemberBinding="{Binding Safety}"/>
                            <GridViewColumn Header="Location" Width="260" DisplayMemberBinding="{Binding Path}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- BOTTOM -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="BottomWarningText"
                       VerticalAlignment="Center"
                       Text="These files will be permanently deleted."
                       Foreground="{DynamicResource DangerBrush}"
                       FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="DeleteButton"
                        Style="{StaticResource DangerButton}"
                        Width="200"
                        Height="40"
                        Click="DeleteButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Permanently Delete"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
