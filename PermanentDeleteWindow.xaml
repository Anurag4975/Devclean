<Window x:Class="DevClean.PermanentDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Permanent Deletion"
        Width="900"
        Height="700"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F6F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">

            <TextBlock Text="⚠ Permanent Deletion"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock x:Name="WarningText"
                       Text="This action cannot be undone."
                       Foreground="#B00020"
                       FontSize="14"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Summary -->
        <Grid Grid.Row="1"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="Files"
                               Foreground="#666"/>

                    <TextBlock x:Name="FileCountText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="Total size"
                               Foreground="#666"/>

                    <TextBlock x:Name="TotalSizeText"
                               Text="0 B"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0,0,0">

                <StackPanel>
                    <TextBlock Text="Safety"
                               Foreground="#666"/>

                    <TextBlock x:Name="SafetySummaryText"
                               Text="Safe: 0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- File list -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="8,4,8,10">

                    <TextBlock Text="Selected files"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="ListCountText"
                               HorizontalAlignment="Right"
                               Foreground="#666"/>
                </Grid>

                <ListView x:Name="FileList"
                          Grid.Row="1">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Header="File"
                                            Width="210"
                                            DisplayMemberBinding="{Binding FileName}"/>

                            <GridViewColumn Header="Size"
                                            Width="90"
                                            DisplayMemberBinding="{Binding SizeDisplay}"/>

                            <GridViewColumn Header="Category"
                                            Width="130"
                                            DisplayMemberBinding="{Binding Category}"/>

                            <GridViewColumn Header="Safety"
                                            Width="100"
                                            DisplayMemberBinding="{Binding Safety}"/>

                            <GridViewColumn Header="Location"
                                            Width="260"
                                            DisplayMemberBinding="{Binding Path}"/>

                        </GridView>
                    </ListView.View>

                </ListView>
            </Grid>
        </Border>

        <!-- Bottom -->
        <Grid Grid.Row="3"
              Margin="0,16,0,0">

            <TextBlock x:Name="BottomWarningText"
                       VerticalAlignment="Center"
                       Text="These files will be permanently deleted."
                       Foreground="#B00020"
                       FontWeight="SemiBold"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Cancel"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="DeleteButton"
                        Content="Permanently Delete"
                        Width="190"
                        Height="40"
                        Click="DeleteButton_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>