<Window x:Class="DevClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DevClean.Converters"
        Title="DevClean" Height="680" Width="1000" MinHeight="640" MinWidth="960"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:SafetyToBrushConverter x:Key="SafetyToBrushConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo + Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryButtonBrush}"
                        VerticalAlignment="Center" Margin="0,0,10,0" ClipToBounds="True">
                    <Image Source="/Assets/AppIcon.png" Width="26" Height="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stretch="Uniform"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">DevClean</TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">Safe cleanup with undo</TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Drive + Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ComboBox x:Name="DriveComboBox" MinWidth="180" Margin="0,0,10,0" FontSize="13"/>
                <TextBlock Text="Free:" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock x:Name="FreeSpaceText" Text="—" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                <Button x:Name="ScanButton" Content="Scan" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ScanButton_Click"/>
                <Button x:Name="SmartCleanButton" Content="Smart Clean" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="SmartCleanButton_Click"/>
                <Button x:Name="ThemeToggleBtn" Content="🌙" Width="36" Click="ThemeToggleBtn_Click" FontSize="16" Padding="0,4"/>
            </StackPanel>
        </Grid>

        <!-- ===== TABS ===== -->
        <TabControl Grid.Row="1" x:Name="MainTabs" Style="{StaticResource ModernTabControl}">

            <!-- ===== CLEAN ===== -->
            <TabItem Header="Clean" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="320" MinWidth="260" MaxWidth="420"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: filters + file list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Type:" Margin="0,6,6,0" VerticalAlignment="Center" FontSize="13"/>
                            <ComboBox x:Name="TypeFilter" MinWidth="100" Margin="0,0,12,0" FontSize="13" SelectionChanged="Filter_SelectionChanged">
                                <ComboBoxItem IsSelected="True" Content="All"/>
                                <ComboBoxItem Content="Files"/>
                                <ComboBoxItem Content="Folders"/>
                            </ComboBox>
                            <TextBlock Text="Category:" Margin="0,6,6,0" VerticalAlignment="Center" FontSize="13"/>
                            <ComboBox x:Name="CategoryFilter" MinWidth="140" Margin="0,0,12,0" FontSize="13" SelectionChanged="Filter_SelectionChanged"/>
                            <TextBlock Text="Safety:" Margin="0,6,6,0" VerticalAlignment="Center" FontSize="13"/>
                            <ComboBox x:Name="SafetyFilter" MinWidth="120" Margin="0,0,16,0" FontSize="13" SelectionChanged="Filter_SelectionChanged"/>
                            <CheckBox x:Name="SelectAllCheckBox" Content="Select all safe" VerticalAlignment="Center" FontSize="13"
                                      Checked="SelectAllCheckBox_Checked" Unchecked="SelectAllCheckBox_Unchecked"/>
                            <TextBlock x:Name="ResultCountText" Text="0 results" Margin="16,6,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <ListView Grid.Row="1" x:Name="CandidateList" SelectionChanged="CandidateList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="36">
                                        <GridViewColumn.Header>
                                            <CheckBox x:Name="SelectAllHeaderCheckBox" ToolTip="Select/deselect all visible items"
                                                      Checked="SelectAllHeaderCheckBox_Checked" Unchecked="SelectAllHeaderCheckBox_Unchecked"/>
                                        </GridViewColumn.Header>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="CandidateCheckBox_Changed" Unchecked="CandidateCheckBox_Changed"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="30">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Fill="{Binding Safety, Converter={StaticResource SafetyToBrushConverter}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                    <GridViewColumn Header="Age" Width="90" DisplayMemberBinding="{Binding AgeDisplay}"/>
                                    <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="Category" Width="110" DisplayMemberBinding="{Binding Category}"/>
                                    <GridViewColumn Header="Safety" Width="90" DisplayMemberBinding="{Binding Safety}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>

                    <!-- RIGHT: progress, stats, details, actions -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Scan Progress" Style="{StaticResource CardGroup}">
                                <StackPanel>
                                    <TextBlock x:Name="ProgressText" Text="Pick a drive and press Scan" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" FontWeight="Normal"/>
                                    <ProgressBar x:Name="ScanProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource PrimaryButtonBrush}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Stats" Style="{StaticResource CardGroup}">
                                <StackPanel>
                                    <Border Background="#E8F0FE" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock><Run Foreground="#0078D4" FontWeight="SemiBold">Scanned: </Run><Run x:Name="FilesScannedText">0</Run></TextBlock>
                                    </Border>
                                    <Border Background="#F8F4E9" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <TextBlock><Run Foreground="#8A6D3B" FontWeight="SemiBold">Candidates: </Run><Run x:Name="CandidatesText">0</Run></TextBlock>
                                    </Border>
                                    <Border Background="#E8F8E8" CornerRadius="6" Padding="10,8">
                                        <TextBlock><Run Foreground="#107C10" FontWeight="SemiBold">Selected: </Run><Run x:Name="SelectedText">0 B</Run></TextBlock>
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Details" Style="{StaticResource CardGroup}">
                                <StackPanel>
                                    <TextBlock x:Name="DetailReasonText" TextWrapping="Wrap" FontSize="13" Text="Select an item to see why it's safe to clean."/>
                                    <TextBlock x:Name="DetailExplanationText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="DetailEvidenceText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                                    <Separator Margin="0,10,0,10"/>

                                    <Button x:Name="CheckWithAiButton" Content="🤖 Check with AI" Click="CheckWithAiButton_Click"
                                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Padding="12,6"/>
                                    <TextBlock x:Name="AiFileVerdictText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="AiFileConsequenceText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="AiFileHowToText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <StackPanel Margin="0,4,0,0">
                                <Button x:Name="OpenLocationButton" Content="Open Location" Margin="0,0,0,8" Click="OpenLocationButton_Click" Style="{StaticResource ModernButton}" Background="#F0F2F5" HorizontalAlignment="Stretch"/>
                                <Button x:Name="QuarantineManagerButton" Content="Quarantine Manager" Margin="0,0,0,8" Click="QuarantineManagerButton_Click" Style="{StaticResource ModernButton}" Background="#E8F0FE" Foreground="#0078D4" HorizontalAlignment="Stretch"/>
                                <Button x:Name="QuarantineButton" Content="Quarantine Selected" Margin="0,0,0,8" Click="QuarantineButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                                <Button x:Name="PermanentDeleteButton" Content="Permanently Delete" Click="PermanentDeleteButton_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== APPS ===== -->
            <TabItem Header="Apps" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="RefreshAppsButton" Content="Refresh List" Margin="0,0,10,0" Click="RefreshAppsButton_Click" Style="{StaticResource ModernButton}"/>
                        <Button x:Name="UninstallAppButton" Content="Uninstall Selected" Click="UninstallAppButton_Click" Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="AppsListView">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="App" Width="260" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Publisher" Width="200" DisplayMemberBinding="{Binding Publisher}"/>
                                <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="Installed" Width="110" DisplayMemberBinding="{Binding InstallDateDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="AppsStatusText" Grid.Row="2" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="Uses each app's own uninstaller — safe and Store-compliant."/>
                </Grid>
            </TabItem>

            <!-- ===== AI ===== -->
            <TabItem Header="AI" Style="{StaticResource ModernTabItem}">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="AI API Key" Style="{StaticResource CardGroup}">
                            <StackPanel>
                                <TextBlock Text="Your key is saved locally and never shared. App sends a capped file list to the AI, then applies its recommendations." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <PasswordBox x:Name="ApiKeyBox" FontSize="13" Padding="8,6"/>
                                <Button x:Name="SaveKeyButton" Content="Save Key" Margin="0,8,0,0" Click="SaveKeyButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="AI Analysis" Style="{StaticResource CardGroup}">
                            <StackPanel>
                                <Button x:Name="AiAnalyzeButton" Content="🔍 Analyze Files with AI" Click="AiAnalyzeButton_Click" Style="{StaticResource SuccessButton}" Margin="0,0,0,10" FontSize="14" Padding="16,10" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="AiStatusText" Text="Click to send file list to the AI for cleanup recommendations." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="AiSummaryText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="AI Recommendations" Style="{StaticResource CardGroup}">
                            <StackPanel>
                                <ListView x:Name="AiResultsList" Height="200">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Path" Width="360" DisplayMemberBinding="{Binding Path}"/>
                                            <GridViewColumn Header="Reason" Width="260" DisplayMemberBinding="{Binding Reason}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Button x:Name="AiQuarantineButton" Content="Quarantine AI-selected" Click="AiQuarantineButton_Click" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== SETTINGS ===== -->
            <TabItem Header="Settings" Style="{StaticResource ModernTabItem}">
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="Quarantine" Style="{StaticResource CardGroup}">
                            <StackPanel>
                                <TextBlock Text="Retention (days):" Margin="0,0,0,4" FontSize="13"/>
                                <TextBox x:Name="RetentionDaysBox" Text="30" Width="80" FontSize="13" Padding="6,4" HorizontalAlignment="Left"/>
                                <CheckBox x:Name="AutoPurgeCheck" Content="Auto-delete items older than retention days" Margin="0,10,0,0" FontSize="13"/>
                                <CheckBox x:Name="SimpleModeCheck" Content="Simple mode — hide filters, auto-select safe items" Margin="0,8,0,0" FontSize="13"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Appearance" Style="{StaticResource CardGroup}">
                            <StackPanel>
                                <TextBlock Text="Theme:" Margin="0,0,0,6" FontSize="13"/>
                                <ComboBox x:Name="ThemeBox" Width="200" FontSize="13" SelectionChanged="ThemeBox_SelectionChanged" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Light" IsSelected="True"/>
                                    <ComboBoxItem Content="Dark"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Advanced" Style="{StaticResource CardGroup}" BorderBrush="#FEDCDC">
                            <StackPanel>
                                <TextBlock Text="⚠️ Format Drive — DESTROYS ALL DATA" Foreground="{StaticResource DangerButtonBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FormatDriveCombo" Grid.Column="0" MinWidth="120" FontSize="13"/>
                                    <Button x:Name="FormatButton" Grid.Column="2" Content="FORMAT" Click="FormatButton_Click" Style="{StaticResource DangerButton}" Margin="10,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Hidden in Microsoft Store builds." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <Button x:Name="SaveSettingsButton" Content="Save All Settings" Click="SaveSettingsButton_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16" HorizontalAlignment="Left"/>
                        <TextBlock Text="DevClean v1.0 · Open core · No telemetry · Everything goes to quarantine first." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>