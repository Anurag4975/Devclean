<Window x:Class="DevClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevClean"
        Width="1200"
        Height="720"
        MinWidth="1000"
        MinHeight="600"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER                                             -->
        <!-- ================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="DevClean" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Find unnecessary files, safely"
                           Style="{StaticResource SecondaryText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ComboBox x:Name="DriveComboBox"
                          Width="230"
                          Margin="4"
                          VerticalContentAlignment="Center"/>

                <Button x:Name="ScanButton"
                        Style="{StaticResource AccentButton}"
                        Click="ScanButton_Click"
                        Width="126">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Scan"/>
                    </StackPanel>
                </Button>

                <Button Content="Quarantine Manager"
                        Click="QuarantineManagerButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================================================= -->
        <!-- SUMMARY                                            -->
        <!-- ================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Files scanned -->
            <Border Grid.Column="0" Style="{StaticResource StatCardBorder}" Margin="0,0,8,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Files scanned" Style="{StaticResource StatLabelText}"/>
                    <TextBlock x:Name="FilesScannedText" Text="0" Style="{StaticResource StatValueText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Candidates -->
            <Border Grid.Column="1" Style="{StaticResource StatCardBorder}" Margin="8,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Candidates" Style="{StaticResource StatLabelText}"/>
                    <TextBlock x:Name="CandidatesText" Text="0" Style="{StaticResource StatValueText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Selected -->
            <Border Grid.Column="2" Style="{StaticResource StatCardBorder}" Margin="8,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Selected" Style="{StaticResource StatLabelText}"/>
                    <TextBlock x:Name="SelectedText" Text="0 B" Style="{StaticResource StatValueText}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Grid.Column="3" Style="{StaticResource StatCardBorder}" Margin="8,0,0,0" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="Status" Style="{StaticResource StatLabelText}"/>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="20" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI Semibold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================= -->
        <!-- PROGRESS                                           -->
        <!-- ================================================= -->
        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <ProgressBar x:Name="ScanProgressBar" IsIndeterminate="False"/>
            <TextBlock x:Name="ProgressText"
                       Text="Ready to scan."
                       Style="{StaticResource SecondaryText}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ================================================= -->
        <!-- FILTERS + LIST                                     -->
        <!-- ================================================= -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FILTERS -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Type"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="TypeFilter"
                              Width="130"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Files"/>
                        <ComboBoxItem Content="Folders"/>
                    </ComboBox>

                    <TextBlock Text="Category"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="24,0,8,0"/>
                    <ComboBox x:Name="CategoryFilter"
                              Width="190"
                              SelectionChanged="Filter_SelectionChanged"/>

                    <TextBlock Text="Safety"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="24,0,8,0"/>
                    <ComboBox x:Name="SafetyFilter"
                              Width="170"
                              SelectionChanged="Filter_SelectionChanged"/>

                    <Border Width="1" Height="20" Background="{StaticResource DividerBrush}" Margin="20,0"/>

                    <TextBlock x:Name="ResultCountText"
                               Text="0 results"
                               VerticalAlignment="Center"
                               Style="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Grid>

            <!-- LIST CONTAINER -->
            <Border Grid.Row="1" Style="{StaticResource ListContainerBorder}" Effect="{StaticResource CardShadow}">
                <Grid>

                    <!-- NORMAL FILE / ALL VIEW -->
                    <ListView x:Name="CandidateList"
                              Visibility="Visible"
                              SelectionChanged="CandidateList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <!-- SELECT -->
                                <GridViewColumn Width="45">
                                    <GridViewColumn.Header>
                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Checked="SelectAllCheckBox_Checked"
                                                  Unchecked="SelectAllCheckBox_Unchecked"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Checked="CandidateCheckBox_Changed"
                                                      Unchecked="CandidateCheckBox_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Type" Width="60" DisplayMemberBinding="{Binding TargetType}"/>
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="Age" Width="90" DisplayMemberBinding="{Binding AgeDisplay}"/>
                                <GridViewColumn Header="Last modified" Width="105" DisplayMemberBinding="{Binding LastModifiedDisplay}"/>
                                <GridViewColumn Header="File / Folder" Width="220" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="Category" Width="130" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Location" Width="130" DisplayMemberBinding="{Binding Location}"/>

                                <!-- SAFETY -->
                                <GridViewColumn Header="Safety" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SafetyIcon, Mode=OneWay}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Safety, Mode=OneWay}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Reason" Width="180" DisplayMemberBinding="{Binding Reason}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- SIMPLE FOLDER VIEW -->
                    <ListView x:Name="FolderList"
                              Visibility="Collapsed"
                              SelectionChanged="CandidateList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="45">
                                    <GridViewColumn.Header>
                                        <CheckBox x:Name="FolderSelectAllCheckBox"
                                                  Checked="SelectAllCheckBox_Checked"
                                                  Unchecked="SelectAllCheckBox_Unchecked"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Checked="CandidateCheckBox_Changed"
                                                      Unchecked="CandidateCheckBox_Changed"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Folder" Width="850">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" FontSize="11.5"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Size" Width="180" DisplayMemberBinding="{Binding SizeDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================= -->
        <!-- BOTTOM ACTIONS                                     -->
        <!-- ================================================= -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SelectedInfoText"
                           Text="Select files to clean."
                           Style="{StaticResource SectionHeaderText}"/>
                <TextBlock Text="Select an item and open its location to inspect it before cleaning."
                           Style="{StaticResource SecondaryText}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="OpenLocationButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Open Location"/>
                    </StackPanel>
                </Button>

                <Button x:Name="QuarantineButton" Click="QuarantineButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Quarantine Selected"/>
                    </StackPanel>
                </Button>

                <Button x:Name="PermanentDeleteButton" Style="{StaticResource DangerButton}" Click="PermanentDeleteButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Permanently Delete"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
