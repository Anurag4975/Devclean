<Window x:Class="DevClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevClean"
        Width="1350"
        Height="850"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F6F8">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="DevClean"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Find unnecessary files safely"
                           FontSize="15"
                           Foreground="#666"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">

                <ComboBox x:Name="DriveComboBox"
                          Width="260"
                          Height="38"
                          VerticalContentAlignment="Center"/>

                <Button x:Name="ScanButton"
                        Content="🔍 Scan"
                        Click="ScanButton_Click"
                        Width="120"
                        Height="38"
                        Margin="8,0,0,0"/>

                <Button Content="Quarantine Manager"
                        Click="QuarantineManagerButton_Click"
                        Height="38"
                        Margin="8,0,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- SUMMARY -->
        <!-- ================================================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Files scanned -->

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,8,0">

                <StackPanel>

                    <TextBlock Text="Files scanned"
                               Foreground="#666"/>

                    <TextBlock x:Name="FilesScannedText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- Candidates -->

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="8,0">

                <StackPanel>

                    <TextBlock Text="Candidates"
                               Foreground="#666"/>

                    <TextBlock x:Name="CandidatesText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- Selected -->

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="8,0">

                <StackPanel>

                    <TextBlock Text="Selected"
                               Foreground="#666"/>

                    <TextBlock x:Name="SelectedText"
                               Text="0 B"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- Status -->

            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="8,0,0,0">

                <StackPanel>

                    <TextBlock Text="Status"
                               Foreground="#666"/>

                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- PROGRESS -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="2"
                    Margin="0,0,0,16">

            <ProgressBar x:Name="ScanProgressBar"
                         Height="8"
                         IsIndeterminate="False"/>

            <TextBlock x:Name="ProgressText"
                       Text="Ready to scan."
                       Foreground="#666"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- FILTERS + LIST -->
        <!-- ================================================= -->

        <Grid Grid.Row="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- FILTERS -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <StackPanel Orientation="Horizontal">

                    <!-- TYPE -->

                    <TextBlock Text="Type:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ComboBox x:Name="TypeFilter"
                              Width="130"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Files"/>
                        <ComboBoxItem Content="Folders"/>

                    </ComboBox>


                    <!-- CATEGORY -->

                    <TextBlock Text="Category:"
                               VerticalAlignment="Center"
                               Margin="20,0,6,0"/>

                    <ComboBox x:Name="CategoryFilter"
                              Width="190"
                              SelectionChanged="Filter_SelectionChanged"/>


                    <!-- SAFETY -->

                    <TextBlock Text="Safety:"
                               VerticalAlignment="Center"
                               Margin="20,0,6,0"/>

                    <ComboBox x:Name="SafetyFilter"
                              Width="170"
                              SelectionChanged="Filter_SelectionChanged"/>


                    <!-- RESULT COUNT -->

                    <TextBlock x:Name="ResultCountText"
                               Text="0 results"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               Margin="20,0,0,0"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- LIST CONTAINER -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="8">

                <Grid>


                    <!-- ================================================= -->
                    <!-- NORMAL FILE / ALL VIEW -->
                    <!-- ================================================= -->

                    <ListView x:Name="CandidateList"
                              Visibility="Visible"
                              SelectionChanged="CandidateList_SelectionChanged">

                        <ListView.View>

                            <GridView>

                                <!-- SELECT -->

                                <GridViewColumn Width="45">

                                    <GridViewColumn.Header>

                                        <CheckBox x:Name="SelectAllCheckBox"
                                                  Checked="SelectAllCheckBox_Checked"
                                                  Unchecked="SelectAllCheckBox_Unchecked"/>

                                    </GridViewColumn.Header>

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Checked="CandidateCheckBox_Changed"
                                                      Unchecked="CandidateCheckBox_Changed"/>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>


                                <!-- TYPE -->

                                <GridViewColumn Header="Type"
                                                Width="75"
                                                DisplayMemberBinding="{Binding TargetType}"/>


                                <!-- SIZE -->

                                <GridViewColumn Header="Size"
                                                Width="95"
                                                DisplayMemberBinding="{Binding SizeDisplay}"/>


                                <!-- AGE -->

                                <GridViewColumn Header="Age"
                                                Width="120"
                                                DisplayMemberBinding="{Binding AgeDisplay}"/>


                                <!-- LAST MODIFIED -->

                                <GridViewColumn Header="Last modified"
                                                Width="135"
                                                DisplayMemberBinding="{Binding LastModifiedDisplay}"/>


                                <!-- FILE / FOLDER -->

                                <GridViewColumn Header="File / Folder"
                                                Width="280"
                                                DisplayMemberBinding="{Binding FileName}"/>


                                <!-- CATEGORY -->

                                <GridViewColumn Header="Category"
                                                Width="170"
                                                DisplayMemberBinding="{Binding Category}"/>


                                <!-- LOCATION -->

                                <GridViewColumn Header="Location"
                                                Width="170"
                                                DisplayMemberBinding="{Binding Location}"/>


                                <!-- SAFETY -->

                                <GridViewColumn Header="Safety"
                                                Width="140">

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="{Binding SafetyIcon, Mode=OneWay}"
                                                           Margin="0,0,5,0"/>

                                                <TextBlock Text="{Binding Safety, Mode=OneWay}"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>


                                <!-- REASON -->

                                <GridViewColumn Header="Reason"
                                                Width="250"
                                                DisplayMemberBinding="{Binding Reason}"/>

                            </GridView>

                        </ListView.View>

                    </ListView>


                    <!-- ================================================= -->
                    <!-- SIMPLE FOLDER VIEW -->
                    <!-- ================================================= -->

                    <ListView x:Name="FolderList"
                              Visibility="Collapsed"
                              SelectionChanged="CandidateList_SelectionChanged">

                        <ListView.View>

                            <GridView>


                                <!-- SELECT -->

                                <GridViewColumn Width="45">

                                    <GridViewColumn.Header>

                                        <CheckBox x:Name="FolderSelectAllCheckBox"
                                                  Checked="SelectAllCheckBox_Checked"
                                                  Unchecked="SelectAllCheckBox_Unchecked"/>

                                    </GridViewColumn.Header>

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Checked="CandidateCheckBox_Changed"
                                                      Unchecked="CandidateCheckBox_Changed"/>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>


                                <!-- FOLDER -->

                                <GridViewColumn Header="Folder"
                                                Width="850">

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock Text="📁"
                                                           FontSize="16"
                                                           Margin="0,0,8,0"/>

                                                <StackPanel>

                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock Text="{Binding Path}"
                                                               FontSize="12"
                                                               Foreground="#777"/>

                                                </StackPanel>

                                            </StackPanel>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>


                                <!-- SIZE -->

                                <GridViewColumn Header="Size"
                                                Width="180"
                                                DisplayMemberBinding="{Binding SizeDisplay}"/>

                            </GridView>

                        </ListView.View>

                    </ListView>

                </Grid>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- BOTTOM ACTIONS -->
        <!-- ================================================= -->

        <Grid Grid.Row="4"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- INFO -->

            <StackPanel>

                <TextBlock x:Name="SelectedInfoText"
                           Text="Select files to clean."
                           FontWeight="SemiBold"/>

                <TextBlock Text="Select an item and open its location to inspect it before cleaning."
                           Foreground="#666"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- BUTTONS -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="📂 Open Location"
                        Click="OpenLocationButton_Click"
                        Height="38"
                        Margin="0,0,8,0"/>

                <Button x:Name="QuarantineButton"
                        Content="🗑 Quarantine Selected"
                        Click="QuarantineButton_Click"
                        Height="38"
                        Margin="0,0,8,0"/>

                <Button x:Name="PermanentDeleteButton"
                        Content="❌ Permanently Delete"
                        Click="PermanentDeleteButton_Click"
                        Height="38"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>