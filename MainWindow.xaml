<Window x:Class="DevClean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevClean"
        Width="1350"
        Height="850"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="manual"
        WindowState="Normal"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F6F8">
    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="DevClean"
                           FontSize="30"
                           FontWeight="Bold"/>

                <TextBlock Text="Find unnecessary files safely"
                           FontSize="15"
                           Foreground="#666"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">

                <ComboBox x:Name="DriveComboBox"
                          Width="260"
                          Height="38"
                          VerticalContentAlignment="Center"/>

                <Button x:Name="ScanButton"
                        Content="🔍 Scan"
                        Click="ScanButton_Click"
                        Width="120"
                        Height="38"/>

                <Button Content="Quarantine Manager"
                        Click="QuarantineManagerButton_Click"
                        Height="38"/>

              

            </StackPanel>

        </Grid>

        <!-- Summary -->
        <Grid Grid.Row="1"
              Margin="0,0,0,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,8,0">

                <StackPanel>
                    <TextBlock Text="Files scanned"
                               Foreground="#666"/>

                    <TextBlock x:Name="FilesScannedText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="Candidates"
                               Foreground="#666"/>

                    <TextBlock x:Name="CandidatesText"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="8,0">

                <StackPanel>
                    <TextBlock Text="Selected"
                               Foreground="#666"/>

                    <TextBlock x:Name="SelectedText"
                               Text="0 B"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>
                </StackPanel>

            </Border>

            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="8"
                    Padding="18"
                    Margin="8,0,0,0">

                <StackPanel>
                    <TextBlock Text="Status"
                               Foreground="#666"/>

                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,6,0,0"/>
                </StackPanel>

            </Border>

        </Grid>

        <!-- Progress -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,16">

            <ProgressBar x:Name="ScanProgressBar"
                         Height="8"
                         IsIndeterminate="False"/>

            <TextBlock x:Name="ProgressText"
                       Text="Ready to scan."
                       Foreground="#666"
                       Margin="0,6,0,0"/>

        </StackPanel>

        <!-- Filters and list -->
        <Grid Grid.Row="3">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filters -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Type:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <ComboBox x:Name="TypeFilter"
                              Width="130"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Files"/>
                        <ComboBoxItem Content="Folders"/>

                    </ComboBox>

                    <TextBlock Text="Category:"
                               VerticalAlignment="Center"
                               Margin="20,0,6,0"/>

                    <ComboBox x:Name="CategoryFilter"
                              Width="190"
                              SelectionChanged="Filter_SelectionChanged"/>

                    <TextBlock Text="Safety:"
                               VerticalAlignment="Center"
                               Margin="20,0,6,0"/>

                    <ComboBox x:Name="SafetyFilter"
                              Width="170"
                              SelectionChanged="Filter_SelectionChanged"/>

                    <TextBlock x:Name="ResultCountText"
                               Text="0 results"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               Margin="20,0,0,0"/>

                </StackPanel>

            </Grid>

            <!-- Candidate list -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="8">

                <ListView x:Name="CandidateList"
                          SelectionChanged="CandidateList_SelectionChanged">

                    <ListView.View>

                        <GridView>

                            <!-- Select -->
                            <GridViewColumn Width="45">

                                <GridViewColumn.Header>

                                    <CheckBox x:Name="SelectAllCheckBox"
                                              Checked="SelectAllCheckBox_Checked"
                                              Unchecked="SelectAllCheckBox_Unchecked"/>

                                </GridViewColumn.Header>

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Checked="CandidateCheckBox_Changed"
                                                  Unchecked="CandidateCheckBox_Changed"/>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <!-- Type -->
                            <GridViewColumn Header="Type"
                                            Width="75"
                                            DisplayMemberBinding="{Binding TargetType}"/>

                            <!-- Size -->
                            <GridViewColumn Header="Size"
                                            Width="95"
                                            DisplayMemberBinding="{Binding SizeDisplay}"/>

                            <!-- Age -->
                            <GridViewColumn Header="Age"
                                            Width="120"
                                            DisplayMemberBinding="{Binding AgeDisplay}"/>

                            <!-- Last modified -->
                            <GridViewColumn Header="Last modified"
                                            Width="135"
                                            DisplayMemberBinding="{Binding LastModifiedDisplay}"/>

                            <!-- File / Folder -->
                            <GridViewColumn Header="File / Folder"
                                            Width="280"
                                            DisplayMemberBinding="{Binding FileName}"/>

                            <!-- Category -->
                            <GridViewColumn Header="Category"
                                            Width="170"
                                            DisplayMemberBinding="{Binding Category}"/>

                            <!-- Location -->
                            <GridViewColumn Header="Location"
                                            Width="170"
                                            DisplayMemberBinding="{Binding Location}"/>

                            <!-- Safety -->
                            <GridViewColumn Header="Safety"
                                            Width="140">

                                <GridViewColumn.CellTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="{Binding SafetyIcon, Mode=OneWay}"
                                                       Margin="0,0,5,0"/>

                                            <TextBlock Text="{Binding Safety, Mode=OneWay}"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </GridViewColumn.CellTemplate>

                            </GridViewColumn>

                            <!-- Reason -->
                            <GridViewColumn Header="Reason"
                                            Width="250"
                                            DisplayMemberBinding="{Binding Reason}"/>

                        </GridView>

                    </ListView.View>

                </ListView>

            </Border>

        </Grid>

        <!-- Bottom -->
        <Grid Grid.Row="4"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock x:Name="SelectedInfoText"
                           Text="Select files to clean."
                           FontWeight="SemiBold"/>

                <TextBlock Text="Select an item and open its location to inspect it before cleaning."
                           Foreground="#666"
                           Margin="0,4,0,0"/>

            </StackPanel>

           <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="📂 Open Location"
            Click="OpenLocationButton_Click"
            Height="38"
            Margin="0,0,8,0"/>

    <Button x:Name="QuarantineButton"
            Content="🗑 Quarantine Selected"
            Click="QuarantineButton_Click"
            Height="38"
            Margin="0,0,8,0"/>

    <Button x:Name="PermanentDeleteButton"
            Content="❌ Permanently Delete"
            Click="PermanentDeleteButton_Click"
            Height="38"/>
</StackPanel>

        </Grid>

    </Grid>
   

</Window>