<Window x:Class="DevClean.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevClean - Quarantine Manager"
        Width="1200"
        Height="700"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Quarantine Manager" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Restore items to their original location, or remove them for good."
                       Style="{StaticResource SecondaryText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ACTIONS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource AccentButton}" Click="RestoreButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="Restore Selected"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource DangerButton}" Click="DeleteButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="Permanently Delete"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- LIST -->
        <Border Grid.Row="2" Style="{StaticResource ListContainerBorder}" Effect="{StaticResource CardShadow}">
            <ListView x:Name="QuarantineList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding TargetType}"/>
                        <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding FileName}"/>
                        <GridViewColumn Header="Original Location" Width="360" DisplayMemberBinding="{Binding OriginalPath}"/>
                        <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeDisplay}"/>
                        <GridViewColumn Header="Quarantined" Width="150" DisplayMemberBinding="{Binding QuarantinedAtDisplay}"/>
                        <GridViewColumn Header="Reason" Width="200" DisplayMemberBinding="{Binding Reason}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}"
                       Text="Loading..."/>

            <Button Grid.Column="1"
                    Content="Close"
                    Click="CloseButton_Click"
                    Width="110"/>
        </Grid>
    </Grid>
</Window>
