<Window x:Class="DevClean.QuarantineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevClean - Quarantine Manager"
        Width="1200"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F8">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Quarantine Manager"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Restore items or permanently remove them."
                       Margin="0,6,0,20"
                       Foreground="#666"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <Button Content="🔄 Refresh"
                    Click="RefreshButton_Click"/>

            <Button Content="↩ Restore Selected"
                    Click="RestoreButton_Click"/>

            <Button Content="🗑 Permanently Delete"
                    Click="DeleteButton_Click"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="10">

            <ListView x:Name="QuarantineList">

                <ListView.View>

                    <GridView>

                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Type"
                                        Width="80"
                                        DisplayMemberBinding="{Binding TargetType}"/>

                        <GridViewColumn Header="Name"
                                        Width="200"
                                        DisplayMemberBinding="{Binding FileName}"/>

                        <GridViewColumn Header="Original Location"
                                        Width="360"
                                        DisplayMemberBinding="{Binding OriginalPath}"/>

                        <GridViewColumn Header="Size"
                                        Width="100"
                                        DisplayMemberBinding="{Binding SizeDisplay}"/>

                        <GridViewColumn Header="Quarantined"
                                        Width="150"
                                        DisplayMemberBinding="{Binding QuarantinedAtDisplay}"/>

                        <GridViewColumn Header="Reason"
                                        Width="200"
                                        DisplayMemberBinding="{Binding Reason}"/>

                    </GridView>

                </ListView.View>

            </ListView>

        </Border>

        <Grid Grid.Row="3"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       Text="Loading..."/>

            <Button Grid.Column="1"
                    Content="Close"
                    Click="CloseButton_Click"
                    Width="100"/>

        </Grid>

    </Grid>

</Window>