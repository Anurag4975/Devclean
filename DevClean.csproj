<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  <UseWPF>true</UseWPF>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>

  <Platforms>x64</Platforms>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>

  <Version>1.0.0</Version>
  <AssemblyVersion>1.0.0.0</AssemblyVersion>
  <FileVersion>1.0.0.0</FileVersion>
  <SelfContained>true</SelfContained>
  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  <Product>DevClean</Product>
  <Company>Anurag Tiwari</Company>
  <Copyright>Copyright © 2026 Anurag Tiwari</Copyright>

  <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

  <EnableMsixTooling>true</EnableMsixTooling>

  <DefineConstants Condition="'$(DefineConstants)'==''">STORE_BUILD</DefineConstants>
</PropertyGroup>

  <ItemGroup>
    <Content Include="Rules\**\*.json"
             Condition="Exists('Rules')"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp"
                      Version="0.6.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK"
                      Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- CopyToOutputDirectory is required so Assets/AppIcon.ico and AppIcon.png
         actually land next to the exe for unpackaged/dev runs — the app's
         "pack://siteoforigin:,,," references (window Icon, header logo) resolve
         against the output directory, not the MSIX payload. Packaged/Store
         builds already include Content items in the payload either way. -->
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>